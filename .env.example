# abckasefi-catalog/.env.example - copy to .env (never commit .env)
# TMDB key (v3 api key or v4 read token) for posters, Czech overviews and the Top rated/Popular lists. Empty = no images.
TMDB_API_KEY=
# Shared secret for the API and the web UI (?token=...). Empty = no auth, only do that on a trusted LAN.
API_TOKEN=
# Keep titles with at least this many IMDb votes (plus any title with a Czech/Slovak name and >= LOCAL_MIN_VOTES).
MIN_VOTES=200
LOCAL_MIN_VOTES=5
TMDB_LANGUAGE=cs-CZ
# Rebuild the catalog from IMDb this often (hours).
IMPORT_EVERY_HOURS=168
# Host directory for catalog.db, the TMDB cache and the IMDb datasets (must be owned by uid 10001).
# DATA_PATH=/opt/abckasefi-catalog/data
